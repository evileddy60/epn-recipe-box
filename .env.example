# Copy this to /etc/epn-recipe-box.env on the Raspberry Pi and edit SECRET_KEY.
SECRET_KEY=change-this-to-a-long-random-secret
EPN_DATA_DIR=/home/pi/epn-recipe-box/data
PORT=5000
# Optional: set the same secret on a trusted peer. If omitted, a random token is stored in data/.sync-token.
SYNC_TOKEN=
SYNC_TIMEOUT_SECONDS=5
