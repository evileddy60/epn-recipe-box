# Copy this to /etc/epn-recipe-box.env on the Raspberry Pi and edit SECRET_KEY.
EPN_ENV=production
SECRET_KEY=change-this-to-a-long-random-secret
EPN_DATA_DIR=/home/pi/epn-recipe-box/data
PORT=5000
# Set EPN_HTTPS=1 only when the service is reached through HTTPS.
# LAN/Tailscale HTTP should keep this at 0 and must not be exposed publicly.
EPN_HTTPS=0
# Optional: set the same secret on a trusted peer. If omitted, a random token is stored in data/.sync-token.
SYNC_TOKEN=
SYNC_TIMEOUT_SECONDS=5
# Canonical HTTPS/Tailscale base URL used by client documentation and deployment checks.
EPN_API_BASE_URL=https://recipe-box.example.ts.net/api/v1
# Individual Android API token lifetime in days.
API_TOKEN_TTL_DAYS=30
# Password reset links expire after this many minutes.
EPN_PASSWORD_RESET_TTL_MINUTES=20
EPN_PASSWORD_RESET_CODE_TTL_MINUTES=10
# Explicit public origin for reset links; required and HTTPS-only in production.
EPN_PUBLIC_BASE_URL=https://epn-hermes-worker-01.tail510dca.ts.net
# Password recovery uses SMTP in production. Keep credentials outside Git.
# The existing shared EPN mail environment may be mapped instead:
# EMAIL_SMTP_HOST, EMAIL_ADDRESS, EMAIL_PASSWORD
# Gmail API uses external files; never place their contents in environment variables.
EPN_GMAIL_TOKEN_FILE=
EPN_GMAIL_CLIENT_SECRET_FILE=
EPN_GMAIL_ACCOUNT=aaron.doug.projects@gmail.com
EPN_MAIL_ENABLED=0
EPN_MAIL_BACKEND=smtp
EPN_MAIL_HOST=
EPN_MAIL_PORT=587
EPN_MAIL_USERNAME=
EPN_MAIL_PASSWORD=
EPN_MAIL_FROM=
EPN_MAIL_USE_TLS=1
