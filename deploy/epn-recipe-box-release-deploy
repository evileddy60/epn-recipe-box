#!/usr/bin/env python3
"""Privileged, Git-independent release installer. Run only through an approved sudo rule."""
from __future__ import annotations

import hashlib
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path
from urllib.request import urlopen

PREFIX = Path(os.environ.get("EPN_RECIPE_BOX_ROOT", "/opt/epn-recipe-box"))
DATA = Path(os.environ.get("EPN_RECIPE_BOX_DATA_DIR", "/var/lib/epn-recipe-box"))
BACKUPS = Path(os.environ.get("EPN_RECIPE_BOX_BACKUP_ROOT", "/var/backups/epn-recipe-box"))
INCOMING = Path(os.environ.get("EPN_RECIPE_BOX_INCOMING", "/var/tmp/epn-recipe-box-incoming"))
SERVICE = os.environ.get("EPN_RECIPE_BOX_SERVICE", "epn-recipe-box-release.service")
LEGACY_SERVICE = "epn-recipe-box.service"
HEALTH_URL = os.environ.get("EPN_RECIPE_BOX_HEALTH_URL", "http://127.0.0.1:5055/api/v1/health")
TAILSCALE_HEALTH_URL = os.environ.get("EPN_RECIPE_BOX_TAILSCALE_HEALTH_URL", "")
EXPECTED_SCHEMA = int(os.environ.get("EPN_RECIPE_BOX_SCHEMA", "14"))
REPOSITORY_URL = "https://github.com/evileddy60/epn-recipe-box.git"
APPROVED_BRANCH = "fix/comment-owner-hide"
FORBIDDEN = (".env", "secret", "token", "credential", "password", "signing-key", "recipe_box.db", "uploads", "recipe-images", "backups")


def fail(message: str) -> "NoReturn":
    raise SystemExit(f"ERROR: {message}")


def under(path: Path, root: Path) -> bool:
    try:
        path.resolve().relative_to(root.resolve())
        return True
    except ValueError:
        return False


def safe_relative(value: str) -> Path:
    path = Path(value)
    if path.is_absolute() or ".." in path.parts or "" in path.parts or "\\" in value:
        fail(f"unsafe path: {value}")
    return path


def digest(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def run(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, text=True, capture_output=True, check=check)


def service_identity() -> tuple[str, str]:
    user = os.environ.get("EPN_RECIPE_BOX_SERVICE_USER", "")
    group = os.environ.get("EPN_RECIPE_BOX_SERVICE_GROUP", "")
    if not user:
        user = run("systemctl", "show", "-p", "User", "--value", SERVICE).stdout.strip()
    if not group:
        group = run("systemctl", "show", "-p", "Group", "--value", SERVICE).stdout.strip()
    if not user or not group:
        fail("service account could not be derived from systemd")
    return user, group


def repair_ownership() -> None:
    user, group = service_identity()
    if not DATA.is_dir() or DATA.is_symlink():
        fail("unsafe Recipe Box data directory")
    for path in (DATA / "recipe_box.db", DATA / "uploads", DATA / "recipe-images"):
        if path.exists() and path.is_symlink():
            fail(f"unsafe data path: {path.name}")
    run("chown", "-R", f"{user}:{group}", str(DATA))
    run("chmod", "750", str(DATA))
    for directory in (DATA / "uploads", DATA / "recipe-images"):
        if directory.exists():
            run("find", str(directory), "-type", "d", "-exec", "chmod", "750", "{}", "+")
            run("find", str(directory), "-type", "f", "-exec", "chmod", "660", "{}", "+")
    db = DATA / "recipe_box.db"
    if db.exists():
        run("chmod", "660", str(db))


def stop_legacy_service() -> None:
    run("systemctl", "disable", "--now", LEGACY_SERVICE, check=False)


def verify_release_directory(release: Path) -> dict:
    if release.is_symlink() or not release.is_dir(): fail("release directory is missing or symlinked")
    manifest_path = release / "manifest.json"
    checksum_path = release / "checksums.sha256"
    if manifest_path.is_symlink() or not manifest_path.is_file(): fail("manifest is missing or symlinked")
    try: manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc: fail(f"manifest is unreadable: {exc}")
    if manifest.get("format") != "epn-recipe-box-release/v1": fail("unsupported release format")
    if manifest.get("branch") != APPROVED_BRANCH or manifest.get("source_repository_url") != REPOSITORY_URL: fail("release repository identity is wrong")
    if not checksum_path.is_file() or checksum_path.is_symlink(): fail("checksums.sha256 is missing or unsafe")
    listed = set()
    for item in manifest.get("files", []):
        if not isinstance(item, dict) or not isinstance(item.get("path"), str): fail("invalid manifest entry")
        relative = safe_relative(item["path"])
        if any(part.lower() in FORBIDDEN or any(token in part.lower() for token in FORBIDDEN[:6]) for part in relative.parts): fail(f"forbidden file: {relative}")
        path = release / relative
        if path.is_symlink() or not path.is_file(): fail(f"release file missing or symlinked: {relative}")
        if path.stat().st_size != item.get("size") or digest(path) != item.get("sha256"): fail(f"release checksum mismatch: {relative}")
        listed.add(relative.as_posix())
    if not (release / "app.py").is_file() or not (release / "requirements.txt").is_file(): fail("required application files are missing")
    if listed != {item["path"] for item in manifest.get("files", [])}: fail("manifest contains duplicate paths")
    for path in release.rglob("*"):
        if path.is_symlink(): fail(f"release contains symlink: {path}")
    return manifest


def verify_backup(path: Path) -> Path:
    path = path.resolve()
    if not under(path, BACKUPS) or path == BACKUPS.resolve() or not path.is_dir(): fail("backup is outside approved root or missing")
    for name in ("recipe_box.db", "uploads", "recipe-images", "manifest.json"):
        item = path / name
        if not item.exists() or item.is_symlink(): fail(f"backup component missing or unsafe: {name}")
    manifest = json.loads((path / "manifest.json").read_text(encoding="utf-8"))
    for item in manifest:
        rel = safe_relative(item["path"])
        target = path / rel
        if target.is_symlink() or not target.is_file() or digest(target) != item["sha256"] or target.stat().st_size != item["size"]: fail(f"backup checksum failed: {rel}")
    with sqlite3.connect(path / "recipe_box.db") as conn:
        if conn.execute("PRAGMA integrity_check").fetchone()[0] != "ok": fail("backup SQLite integrity failed")
    return path


def make_backup() -> Path:
    BACKUPS.mkdir(parents=True, exist_ok=True)
    target = BACKUPS / f"pre-deploy-{__import__('datetime').datetime.now(__import__('datetime').timezone.utc).strftime('%Y%m%d-%H%M%S')}"
    target.mkdir(mode=0o700)
    with sqlite3.connect(DATA / "recipe_box.db") as source, sqlite3.connect(target / "recipe_box.db") as copied: source.backup(copied)
    for name in ("uploads", "recipe-images"):
        shutil.copytree(DATA / name, target / name)
    entries = []
    for item in sorted(p for p in target.rglob("*") if p.is_file() and p.name != "manifest.json"):
        entries.append({"path": item.relative_to(target).as_posix(), "size": item.stat().st_size, "sha256": digest(item)})
    (target / "manifest.json").write_text(json.dumps(entries, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    verify_backup(target)
    print(target)
    return target


def stage(archive_arg: str, checksum_arg: str) -> str:
    archive = Path(archive_arg).resolve(); checksum = Path(checksum_arg).resolve()
    if not under(archive, INCOMING) or not under(checksum, INCOMING): fail("stage inputs must be under incoming directory")
    if archive.is_symlink() or checksum.is_symlink() or not archive.is_file() or not checksum.is_file(): fail("stage input is missing or symlinked")
    expected = checksum.read_text(encoding="utf-8").split()[0]
    if digest(archive) != expected: fail("detached archive checksum failed")
    with tempfile.TemporaryDirectory(prefix="release-verify-", dir=INCOMING) as temp:
        temp_path = Path(temp)
        with tarfile.open(archive, "r:gz") as bundle:
            for member in bundle.getmembers():
                safe_relative(member.name)
                if member.issym() or member.islnk() or not (member.isfile() or member.isdir()): fail("archive contains unsafe member")
            bundle.extractall(temp_path)
        roots = [p for p in temp_path.iterdir() if p.is_dir()]
        if len(roots) != 1: fail("archive must contain one release directory")
        manifest = verify_release_directory(roots[0]); release_id = manifest["release_id"]
        if release_id != roots[0].name: fail("release ID does not match directory")
        destination = PREFIX / "releases" / release_id
        if destination.exists(): fail("release already exists")
        PREFIX.joinpath("releases").mkdir(parents=True, exist_ok=True)
        shutil.copytree(roots[0], destination)
    print(release_id)
    return release_id


def health() -> None:
    for url in (HEALTH_URL, TAILSCALE_HEALTH_URL):
        if url:
            with urlopen(url, timeout=20) as response:
                if response.status >= 400: fail(f"health check failed: {url}")


def restore(backup_path: str) -> None:
    backup = verify_backup(Path(backup_path))
    stop_legacy_service()
    run("systemctl", "stop", SERVICE)
    stage = DATA / ".restore-stage"
    if stage.exists(): shutil.rmtree(stage)
    stage.mkdir(parents=True)
    shutil.copy2(backup / "recipe_box.db", stage / "recipe_box.db")
    for name in ("uploads", "recipe-images"):
        shutil.copytree(backup / name, stage / name)
    for name in ("recipe_box.db", "uploads", "recipe-images"):
        target = DATA / name
        if target.exists():
            if target.is_dir(): shutil.rmtree(target)
            else: target.unlink()
        os.replace(stage / name, target)
    shutil.rmtree(stage, ignore_errors=True)
    repair_ownership()
    print(f"restored {backup}")


def activate(release_id: str, backup_path: str) -> None:
    release = PREFIX / "releases" / release_id; manifest = verify_release_directory(release)
    verify_backup(Path(backup_path))
    stop_legacy_service()
    run("systemctl", "stop", SERVICE)
    link = PREFIX / "current"; temporary = PREFIX / f".current.{release_id}.tmp"
    if temporary.exists() or temporary.is_symlink(): temporary.unlink()
    temporary.symlink_to(release)
    os.replace(temporary, link)
    migration = os.environ.get("EPN_RECIPE_BOX_MIGRATION_COMMAND", "")
    if migration: subprocess.run(migration, shell=True, cwd=link, check=True)
    repair_ownership()
    run("systemctl", "start", SERVICE)
    health()
    print(f"activated {release_id} schema={manifest['expected_schema_version']}")


def rollback(previous_id: str, backup_path: str) -> None:
    previous = PREFIX / "releases" / previous_id; verify_release_directory(previous); verify_backup(Path(backup_path))
    stop_legacy_service()
    run("systemctl", "stop", SERVICE)
    stage = DATA / ".rollback-stage"
    if stage.exists(): shutil.rmtree(stage)
    stage.mkdir()
    shutil.copy2(Path(backup_path) / "recipe_box.db", stage / "recipe_box.db")
    for name in ("uploads", "recipe-images"): shutil.copytree(Path(backup_path) / name, stage / name)
    for name in ("recipe_box.db", "uploads", "recipe-images"):
        old = DATA / f".{name}.rollback-old"
        if old.exists(): old.unlink() if old.is_file() else shutil.rmtree(old)
        if (DATA / name).exists(): os.replace(DATA / name, old)
        os.replace(stage / name, DATA / name)
    temporary = PREFIX / f".current.rollback.tmp"; temporary.symlink_to(previous); os.replace(temporary, PREFIX / "current")
    repair_ownership()
    run("systemctl", "start", SERVICE); health(); print(f"rolled back {previous_id}")


def main() -> int:
    op = sys.argv[1] if len(sys.argv) > 1 else ""
    if op == "info": print(f"root={PREFIX}\ncurrent={os.path.realpath(PREFIX / 'current') if (PREFIX / 'current').exists() else 'none'}\ndata={DATA}\nbackup_root={BACKUPS}\nincoming={INCOMING}")
    elif op == "self-check":
        for path in (PREFIX, DATA, BACKUPS, INCOMING): path.mkdir(parents=True, exist_ok=True)
        print("self-check=ok")
    elif op == "backup": make_backup()
    elif op == "verify-backup" and len(sys.argv) == 3: print(verify_backup(Path(sys.argv[2])))
    elif op == "restore" and len(sys.argv) == 3: restore(sys.argv[2])
    elif op == "stage-release" and len(sys.argv) == 4: stage(sys.argv[2], sys.argv[3])
    elif op == "verify-release" and len(sys.argv) == 3: print(json.dumps(verify_release_directory(PREFIX / "releases" / sys.argv[2]), indent=2, sort_keys=True))
    elif op == "activate-release" and len(sys.argv) == 4: activate(sys.argv[2], sys.argv[3])
    elif op == "rollback" and len(sys.argv) == 4: rollback(sys.argv[2], sys.argv[3])
    elif op == "list-releases": print("\n".join(sorted(p.name for p in (PREFIX / "releases").iterdir() if p.is_dir())))
    elif op == "cleanup-releases": print("cleanup requires an explicit retention policy review; no automatic deletion performed")
    elif op == "status": run("systemctl", "status", "--no-pager", SERVICE, check=True); print("status=ok")
    elif op == "restart": run("systemctl", "restart", SERVICE); health()
    elif op == "health": health(); print("health=ok")
    else: fail("usage: info|self-check|backup|verify-backup PATH|restore BACKUP|stage-release ARCHIVE CHECKSUM|verify-release ID|activate-release ID BACKUP|rollback ID BACKUP|list-releases|cleanup-releases|restart|health|status")
    return 0


if __name__ == "__main__": raise SystemExit(main())
