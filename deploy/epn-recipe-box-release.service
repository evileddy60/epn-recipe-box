[Unit]
Description=EPN Recipe Box Flask app (release layout)
After=network-online.target
Wants=network-online.target
Conflicts=epn-recipe-box.service

[Service]
Type=simple
User=epn-recipe-box
Group=epn-recipe-box
WorkingDirectory=/opt/epn-recipe-box/current
EnvironmentFile=-/etc/epn-recipe-box/epn-recipe-box.env
ExecStart=/opt/epn-recipe-box/shared/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5055 --access-logfile - --access-logformat "%(h)s %(m)s %(U)s %(s)s %(M)sms" --error-logfile - app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/epn-recipe-box/releases /opt/epn-recipe-box/current
ReadWritePaths=/opt/epn-recipe-box/shared /var/lib/epn-recipe-box
UMask=0077

[Install]
WantedBy=multi-user.target
